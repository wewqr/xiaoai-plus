[deepseek]
api_key = your_deepseek_api_key
api_base = https://api.deepseek.com
model = deepseek-flash
voice_id = stella
system_role = 你是运行在小米智能音箱上的DeepSeek语音助手。回答自然、准确、简洁，适合直接朗读。
max_tokens = 256
vad_rms_threshold = 500
speech_end_ms = 700
max_utterance_seconds = 30

[wakeup]
say_hello = __chime__

[audio]
playback_gain = 1.0
